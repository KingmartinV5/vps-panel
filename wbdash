#!/usr/bin/env bash
# wbdash -- self-installing launcher for the KingsEmpire Manage Panel.
#
# First run (as root or via sudo):   sudo ./wbdash install
# After that, from anywhere:         wbdash
#
# `wbdash install` installs whatever system packages are missing (the Go
# toolchain, Docker), compiles the panel into a single static binary next to
# this script, and symlinks this script into /usr/local/bin/wbdash so it's on
# PATH. Everything after that runs as your normal user -- only the install
# step (and rebuilding after a source update) needs root.
set -euo pipefail

# --- Resolve where this script (and therefore the app) actually lives, ---
# --- even when invoked through the /usr/local/bin/wbdash symlink.       ---
SELF_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
APP_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
PANEL_BIN="$APP_DIR/panel"
PIDFILE="$APP_DIR/instance/wbdash.pid"
LOGFILE="$APP_DIR/panel.log"
CONF_FILE="$APP_DIR/instance/wbdash.conf"
BIN_LINK="/usr/local/bin/wbdash"

WBDASH_HOST_DEFAULT="127.0.0.1"
WBDASH_PORT_DEFAULT="5000"
if [[ -f "$CONF_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONF_FILE"
fi

DEBUG_PASSWORD="1408"
DEMO_PORT="7114"
DEMO_PIDFILE="$APP_DIR/instance/wbdash-demo.pid"
DEMO_LOGFILE="$APP_DIR/instance/demo-panel.log"
DEMO_DB_URL="sqlite:///$APP_DIR/instance/demo.db"
DEMO_SERVERS_ROOT="$APP_DIR/data/demo-servers"
DEMO_BACKUPS_ROOT="$APP_DIR/data/demo-backups"
DEMO_PLUGIN_CATALOG_ROOT="$APP_DIR/data/demo-plugin-catalog"
CLOUDFLARED_BIN="$APP_DIR/bin/cloudflared"

# Separate password from DEBUG_PASSWORD on purpose -- these gate two very
# different things (a throwaway public demo vs. touching real /etc config on
# a production box) and shouldn't be forced to move together later.
PRODUCTION_PASSWORD="1408"
PROD_CONF_FILE="$APP_DIR/instance/production.conf"
TLS_DIR="$APP_DIR/instance/tls"

PROD_CONFIGURED=0
PROD_WEBSERVER="none"
PROD_TLS="none"
PROD_DOMAIN=""
PROD_VHOST_PATH=""
if [[ -f "$PROD_CONF_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$PROD_CONF_FILE"
fi

UI_BACKEND=""
UI_RESULT=""

PKG_MGR=""

log()  { echo "[wbdash] $*"; }
die()  { echo "[wbdash] error: $*" >&2; exit 1; }

# Launches "$@" fully detached (own session/process group, stdin closed) so
# it survives the launching script exiting or being Ctrl+C'd -- plain nohup
# alone doesn't protect against that when job control is off, which is the
# normal case for a script (non-interactive shell), even one run from an
# interactive terminal.
bg_run() {
  local logfile="$1" pidfile="$2"
  shift 2
  if command -v setsid >/dev/null 2>&1; then
    setsid "$@" > "$logfile" 2>&1 < /dev/null &
  else
    nohup "$@" > "$logfile" 2>&1 < /dev/null &
  fi
  echo $! > "$pidfile"
  disown
}

