# --- Package manager detection -------------------------------------------

detect_pkg_mgr() {
  if command -v apt-get >/dev/null 2>&1; then PKG_MGR=apt
  elif command -v dnf >/dev/null 2>&1; then PKG_MGR=dnf
  elif command -v yum >/dev/null 2>&1; then PKG_MGR=yum
  elif command -v pacman >/dev/null 2>&1; then PKG_MGR=pacman
  elif command -v apk >/dev/null 2>&1; then PKG_MGR=apk
  elif command -v zypper >/dev/null 2>&1; then PKG_MGR=zypper
  else PKG_MGR=""
  fi
  log "package manager: ${PKG_MGR:-none detected}"
}

pkg_update() {
  case "$PKG_MGR" in
    apt) apt-get update ;;
    *) : ;;
  esac
}

pkg_install() {
  case "$PKG_MGR" in
    apt) DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" ;;
    dnf) dnf install -y "$@" ;;
    yum) yum install -y "$@" ;;
    pacman) pacman -Sy --noconfirm "$@" ;;
    apk) apk add --no-cache "$@" ;;
    zypper) zypper --non-interactive install "$@" ;;
    *) die "no supported package manager found -- install manually: $*" ;;
  esac
}

# --- Dependency bootstrapping ---------------------------------------------

ensure_go() {
  pkg_update
  if ! command -v go >/dev/null 2>&1; then
    log "Go toolchain not found, installing..."
    case "$PKG_MGR" in
      apt) pkg_install golang-go ;;
      dnf|yum) pkg_install golang ;;
      pacman) pkg_install go ;;
      apk) pkg_install go ;;
      zypper) pkg_install go ;;
    esac
  fi
  command -v go >/dev/null 2>&1 || die "Go toolchain still unavailable after installing packages -- install it manually (https://go.dev/doc/install), then re-run 'sudo wbdash install'"
  log "go: $(go version)"
}

ensure_docker() {
  local assume_yes="$1" real_user="$2"
  if command -v docker >/dev/null 2>&1; then
    log "docker: found ($(docker --version 2>/dev/null || echo present))"
  else
    if [[ "$assume_yes" != "1" ]]; then
      read -r -p "[wbdash] Docker was not found and is required to run servers. Install it now via get.docker.com? [y/N] " reply
      case "$reply" in
        y|Y|yes|YES) : ;;
        *) log "skipping Docker install -- install it yourself, then re-run 'sudo wbdash install'."; return 0 ;;
      esac
    fi
    log "installing Docker via get.docker.com..."
    if curl -fsSL https://get.docker.com -o /tmp/wbdash-get-docker.sh 2>/dev/null \
      || wget -qO /tmp/wbdash-get-docker.sh https://get.docker.com 2>/dev/null; then
      sh /tmp/wbdash-get-docker.sh
      rm -f /tmp/wbdash-get-docker.sh
    else
      die "could not reach get.docker.com -- install Docker manually, then re-run 'sudo wbdash install'"
    fi
  fi

  systemctl enable --now docker >/dev/null 2>&1 \
    || service docker start >/dev/null 2>&1 \
    || rc-service docker start >/dev/null 2>&1 \
    || true

  if command -v docker >/dev/null 2>&1 && ! id -nG "$real_user" 2>/dev/null | grep -qw docker; then
    usermod -aG docker "$real_user" 2>/dev/null \
      && log "added '$real_user' to the docker group -- log out/in (or run 'newgrp docker') for it to take effect"
  fi
}

build_panel_as() {
  local user="$1"
  log "compiling panel binary (this pulls Go module dependencies on first build, may take a few minutes)..."
  # -H gives the build its own $HOME so Go's module/build cache lands under
  # the real user's home, not root's (this runs under sudo during install).
  # CGO_ENABLED=0 keeps the result a single static binary with no libc
  # dependency, matching how it's built and tested upstream.
  sudo -u "$user" -H env CGO_ENABLED=0 go build -o "$PANEL_BIN" "$APP_DIR"
  [[ -x "$PANEL_BIN" ]] || die "build finished but $PANEL_BIN is missing -- check the output above"
}

symlink_self() {
  ln -sf "$APP_DIR/wbdash" "$BIN_LINK"
  chmod +x "$APP_DIR/wbdash"
  log "linked $BIN_LINK -> $APP_DIR/wbdash"
}

cmd_install() {
  local assume_yes=0
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) assume_yes=1 ;;
    esac
  done

  if [[ $EUID -ne 0 ]]; then
    log "installing system packages requires root, re-running with sudo..."
    exec sudo -E "$SELF_PATH" install "$@"
  fi

  local real_user
  real_user="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"

  detect_pkg_mgr
  ensure_go
  ensure_docker "$assume_yes" "$real_user"
  build_panel_as "$real_user"
  mkdir -p "$APP_DIR/instance" "$APP_DIR/data/servers" "$APP_DIR/data/backups"
  chown -R "$real_user" "$APP_DIR/instance" "$APP_DIR/data" "$PANEL_BIN"
  symlink_self

  log "install complete. Run: wbdash start   (or just: wbdash)"
}

# --- Run / stop / status ---------------------------------------------------

require_installed() {
  [[ -x "$PANEL_BIN" ]] || die "not installed yet -- run: sudo wbdash install"
}

save_conf() {
  mkdir -p "$(dirname "$CONF_FILE")"
  printf 'WBDASH_HOST_DEFAULT=%q\nWBDASH_PORT_DEFAULT=%q\n' "$1" "$2" > "$CONF_FILE"
}

cmd_start() {
  require_installed
  local host="$WBDASH_HOST_DEFAULT" port="$WBDASH_PORT_DEFAULT" daemon=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host) host="$2"; shift 2 ;;
      --port) port="$2"; shift 2 ;;
      --daemon) daemon=1; shift ;;
      *) die "unknown option to start: $1" ;;
    esac
  done
  save_conf "$host" "$port"

  if command -v groups >/dev/null 2>&1 && ! groups | grep -qw docker && [[ $EUID -ne 0 ]]; then
    log "warning: this shell session doesn't have the 'docker' group active yet -- log out/in or run 'newgrp docker' if the panel can't reach Docker"
  fi

  mkdir -p "$(dirname "$PIDFILE")"

  if [[ $daemon -eq 1 ]]; then
    if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      log "already running (pid $(cat "$PIDFILE"))"
      exit 0
    fi
    bg_run "$LOGFILE" "$PIDFILE" env PANEL_HOST="$host" PANEL_PORT="$port" "$PANEL_BIN" serve
    sleep 1
    log "started in background (pid $(cat "$PIDFILE")), logs: $LOGFILE"
    log "URL: http://$host:$port"
  else
    log "starting on http://$host:$port (Ctrl+C to stop)"
    PANEL_HOST="$host" PANEL_PORT="$port" exec "$PANEL_BIN" serve
  fi
}

cmd_stop() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    kill "$(cat "$PIDFILE")"
    rm -f "$PIDFILE"
    log "stopped"
  else
    log "not running (no active pidfile)"
  fi
}

cmd_status() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    log "running (pid $(cat "$PIDFILE"))"
  else
    log "not running"
  fi
}

cmd_manage() {
  require_installed
  exec "$PANEL_BIN" manage "$@"
}

# --- Demo/debug mode ---------------------------------------------------

detect_lan_ip() {
  local ip
  ip="$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}')"
  [[ -z "$ip" ]] && ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  echo "$ip"
}

ensure_cloudflared() {
  if command -v cloudflared >/dev/null 2>&1; then
    CLOUDFLARED_BIN="$(command -v cloudflared)"
    return
  fi
  if [[ -x "$CLOUDFLARED_BIN" ]]; then
    return
  fi
  log "cloudflared not found, downloading a static binary for the demo tunnel..."
  mkdir -p "$APP_DIR/bin"
  local arch
  case "$(uname -m)" in
    x86_64) arch="amd64" ;;
    aarch64|arm64) arch="arm64" ;;
    armv7l|armv6l) arch="arm" ;;
    *) die "unsupported architecture for cloudflared: $(uname -m) -- install cloudflared manually and put it on PATH" ;;
  esac
  local url="https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${arch}"
  curl -fsSL "$url" -o "$CLOUDFLARED_BIN" 2>/dev/null || wget -qO "$CLOUDFLARED_BIN" "$url" \
    || die "failed to download cloudflared from $url"
  chmod +x "$CLOUDFLARED_BIN"
}

cmd_debug() {
  if [[ "${1:-}" == "stop" ]]; then
    if [[ -f "$DEMO_PIDFILE" ]] && kill -0 "$(cat "$DEMO_PIDFILE")" 2>/dev/null; then
      kill "$(cat "$DEMO_PIDFILE")"
      rm -f "$DEMO_PIDFILE"
      log "demo panel stopped"
    else
      log "demo panel not running"
    fi
    return
  fi

  require_installed
  command -v docker >/dev/null 2>&1 || die "docker is required for the demo -- run 'sudo wbdash install' first"

  read -r -s -p "[wbdash] Password: " pass
  echo
  if [[ "$pass" != "$DEBUG_PASSWORD" ]]; then
    die "incorrect password"
  fi

  ensure_cloudflared

  log "seeding demo data (safe to re-run -- fake servers, separate from real data)..."
  PANEL_DATABASE_URL="$DEMO_DB_URL" \
  PANEL_SERVERS_ROOT="$DEMO_SERVERS_ROOT" \
  PANEL_BACKUPS_ROOT="$DEMO_BACKUPS_ROOT" \
  PANEL_PLUGIN_CATALOG_ROOT="$DEMO_PLUGIN_CATALOG_ROOT" \
    "$PANEL_BIN" demo-seed

  mkdir -p "$(dirname "$DEMO_PIDFILE")"
  if [[ -f "$DEMO_PIDFILE" ]] && kill -0 "$(cat "$DEMO_PIDFILE")" 2>/dev/null; then
    log "demo panel already running (pid $(cat "$DEMO_PIDFILE"))"
  else
    # bound to 0.0.0.0 (not just loopback) so it's also reachable directly
    # on the LAN at $DEMO_PORT -- a fallback in case the public tunnel is
    # having trouble, since cloudflared's quick tunnels are occasionally flaky.
    bg_run "$DEMO_LOGFILE" "$DEMO_PIDFILE" env \
      PANEL_HOST=0.0.0.0 PANEL_PORT="$DEMO_PORT" \
      PANEL_DATABASE_URL="$DEMO_DB_URL" \
      PANEL_SERVERS_ROOT="$DEMO_SERVERS_ROOT" \
      PANEL_BACKUPS_ROOT="$DEMO_BACKUPS_ROOT" \
      PANEL_PLUGIN_CATALOG_ROOT="$DEMO_PLUGIN_CATALOG_ROOT" \
      "$PANEL_BIN" serve
    sleep 1
    log "demo panel running on port $DEMO_PORT"
  fi

  local lan_ip
  lan_ip="$(detect_lan_ip)"

  log "opening a public link for screenshots (Ctrl+C to close it)..."
  local tunnel_log tunnel_pid url
  tunnel_log="$(mktemp)"
  "$CLOUDFLARED_BIN" tunnel --url "http://127.0.0.1:$DEMO_PORT" > "$tunnel_log" 2>&1 &
  tunnel_pid=$!

  # shellcheck disable=SC2317
  cleanup_tunnel() { kill "${tunnel_pid:-}" 2>/dev/null || true; rm -f "${tunnel_log:-}"; }
  trap cleanup_tunnel EXIT INT TERM

  url=""
  for _ in $(seq 1 30); do
    url="$(grep -oE 'https://[a-zA-Z0-9-]+\.trycloudflare\.com' "$tunnel_log" 2>/dev/null | head -1 || true)"
    [[ -n "$url" ]] && break
    kill -0 "$tunnel_pid" 2>/dev/null || { log "cloudflared exited early -- check: $tunnel_log"; break; }
    sleep 1
  done

  echo
  if [[ -n "$url" ]]; then
    log "Public demo link:  $url"
  else
    log "warning: no public tunnel link came up (check $tunnel_log) -- use the LAN link below"
  fi
  if [[ -n "$lan_ip" ]]; then
    log "LAN demo link:     http://$lan_ip:$DEMO_PORT"
  else
    log "LAN demo link:     http://<this-machine's-LAN-IP>:$DEMO_PORT  (couldn't auto-detect the IP)"
  fi
  log "Log in as 'demo-admin' or 'demo', password: demo1408"
  echo
  log "The public link is unguessable but live for as long as this keeps running."
  log "Press Ctrl+C when you're done taking screenshots (stops the tunnel; the LAN"
  log "link and demo panel keep running -- 'wbdash debug stop' to fully shut it down)."
  wait "$tunnel_pid" 2>/dev/null || true
}

# --- Production hardening wizard -------------------------------------------
#
# `wbdash production` fronts the panel with a real reverse proxy (nginx or
# Apache), optionally gets it a TLS cert, and rebinds the panel itself to
# 127.0.0.1 so it's only reachable through that proxy. Password-gated on
# every run; the interactive wizard itself only runs once (state cached in
# $PROD_CONF_FILE) unless --reconfigure is passed.

# try_pkg_install is pkg_install's non-fatal twin: pkg_install calls die() on
# an unsupported package manager or a failed install, which would kill the
# whole wizard over an optional component (nginx/apache/certbot/dialog).
# Everything in this section that's "nice to have, degrade gracefully" goes
# through this instead.
try_pkg_install() {
  case "$PKG_MGR" in
    apt) DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" ;;
    dnf) dnf install -y "$@" ;;
    yum) yum install -y "$@" ;;
    pacman) pacman -Sy --noconfirm "$@" ;;
    apk) apk add --no-cache "$@" ;;
    zypper) zypper --non-interactive install "$@" ;;
    *) return 1 ;;
  esac
}

# --- Tiny UI abstraction: dialog(1) TUI with a plain-prompt fallback -------
# Every wizard step goes through ui_menu/ui_yesno/ui_input/ui_msg so the
# actual wizard logic below doesn't care which backend rendered it. All of
# them set $UI_RESULT (menu/input) rather than echoing, so callers can use
# them without a subshell. Cancel (ESC) is a normal outcome, not an error --
# callers must not invoke these bare under `set -e`; always via `if` or
# `... || true`, then check $UI_RESULT.

ensure_dialog() {
  if command -v dialog >/dev/null 2>&1; then
    UI_BACKEND="dialog"
    return
  fi
  log "installing 'dialog' for the interactive setup menu..."
  if try_pkg_install dialog && command -v dialog >/dev/null 2>&1; then
    UI_BACKEND="dialog"
  else
    log "warning: couldn't install 'dialog' -- falling back to plain y/n prompts"
    UI_BACKEND="plain"
  fi
}

ui_menu() {
  # ui_menu <title> <prompt> <tag1> <label1> [<tag2> <label2> ...]
  local title="$1" prompt="$2"
  shift 2
  UI_RESULT=""
  if [[ "$UI_BACKEND" == "dialog" ]]; then
    UI_RESULT="$(dialog --backtitle "KingsEmpire Manage Panel -- Production Setup" \
      --title "$title" --menu "$prompt" 16 70 6 "$@" 3>&1 1>&2 2>&3)" || true
    clear
  else
    echo
    echo "== $title =="
    echo "$prompt"
    local args=("$@") i=0
    while [[ $i -lt ${#args[@]} ]]; do
      echo "  ${args[$i]}) ${args[$((i+1))]}"
      i=$((i+2))
    done
    read -r -p "Choice: " UI_RESULT
  fi
}

ui_yesno() {
  local prompt="$1"
  if [[ "$UI_BACKEND" == "dialog" ]]; then
    dialog --backtitle "KingsEmpire Manage Panel -- Production Setup" --yesno "$prompt" 10 70
    local rc=$?
    clear
    return $rc
  else
    local reply
    read -r -p "$prompt [y/N] " reply
    case "$reply" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
  fi
}

ui_input() {
  local prompt="$1" default="${2:-}"
  UI_RESULT=""
  if [[ "$UI_BACKEND" == "dialog" ]]; then
    UI_RESULT="$(dialog --backtitle "KingsEmpire Manage Panel -- Production Setup" \
      --inputbox "$prompt" 10 70 "$default" 3>&1 1>&2 2>&3)" || true
    clear
  else
    local val
    read -r -p "$prompt${default:+ [$default]}: " val
    UI_RESULT="${val:-$default}"
  fi
}

ui_msg() {
  local msg="$1"
  if [[ "$UI_BACKEND" == "dialog" ]]; then
    dialog --backtitle "KingsEmpire Manage Panel -- Production Setup" --msgbox "$msg" 14 72
    clear
  else
    echo
    echo "$msg"
    echo
  fi
}

# --- Web server config generation ------------------------------------------

# Maps a chosen "nginx"/"apache" choice to the right package + service unit
# name for the detected distro. Sets $WS_PKG and $WS_SVC. The service name
# also doubles as the installed-binary name we probe with `command -v`
# (true for nginx everywhere, apache2 on Debian/Alpine/SUSE, httpd on
# RHEL-likes and Arch).
webserver_pkg_and_svc() {
  local ws="$1"
  case "$ws:$PKG_MGR" in
    nginx:*) WS_PKG="nginx"; WS_SVC="nginx" ;;
    apache:apt) WS_PKG="apache2"; WS_SVC="apache2" ;;
    apache:dnf|apache:yum) WS_PKG="httpd"; WS_SVC="httpd" ;;
    apache:pacman) WS_PKG="apache"; WS_SVC="httpd" ;;
    apache:apk) WS_PKG="apache2"; WS_SVC="apache2" ;;
    apache:zypper) WS_PKG="apache2"; WS_SVC="apache2" ;;
    *) WS_PKG="$ws"; WS_SVC="$ws" ;;
  esac
}

resolve_nginx_conf_path() {
  if [[ -d /etc/nginx/conf.d ]]; then
    NGINX_CONF_PATH="/etc/nginx/conf.d/kingsempire-panel.conf"
  elif [[ -d /etc/nginx/sites-available ]]; then
    NGINX_CONF_PATH="/etc/nginx/sites-available/kingsempire-panel"
  else
    NGINX_CONF_PATH="/etc/nginx/kingsempire-panel.conf"
  fi
}

resolve_apache_conf_path() {
  if [[ -d /etc/apache2/sites-available ]]; then
    APACHE_CONF_PATH="/etc/apache2/sites-available/kingsempire-panel.conf"
  elif [[ -d /etc/httpd/conf.d ]]; then
    APACHE_CONF_PATH="/etc/httpd/conf.d/kingsempire-panel.conf"
  elif [[ -d /etc/apache2/conf.d ]]; then
    APACHE_CONF_PATH="/etc/apache2/conf.d/kingsempire-panel.conf"
  else
    APACHE_CONF_PATH="/etc/apache2/kingsempire-panel.conf"
  fi
}

# write_vhost <nginx|apache> <domain> <port> <none|selfsigned>
# ("letsencrypt" mode isn't handled here -- certbot rewrites the plain-HTTP
# vhost written by the "none" mode itself, via its --nginx/--apache plugin.)
write_vhost() {
  local webserver="$1" domain="$2" port="$3" mode="$4"
  if [[ "$webserver" == "nginx" ]]; then
    write_nginx_vhost "$domain" "$port" "$mode"
  else
    write_apache_vhost "$domain" "$port" "$mode"
  fi
}

write_nginx_vhost() {
  local domain="$1" port="$2" mode="$3"
  resolve_nginx_conf_path
  mkdir -p "$(dirname "$NGINX_CONF_PATH")"
  # proxy_buffering off + a long proxy_read_timeout matter here: the console
  # is a long-lived Server-Sent-Events connection (see
  # internal/web/server_handlers.go's handleConsoleStream), and nginx's
  # 60s default read timeout plus response buffering would otherwise cut
  # every console tab after a minute of no new log lines.
  if [[ "$mode" == "selfsigned" ]]; then
    cat > "$NGINX_CONF_PATH" <<EOF
server {
    listen 80;
    server_name $domain;
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl;
    server_name $domain;

    ssl_certificate     $TLS_DIR/selfsigned.crt;
    ssl_certificate_key $TLS_DIR/selfsigned.key;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
EOF
  else
    cat > "$NGINX_CONF_PATH" <<EOF
server {
    listen 80;
    server_name $domain;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
EOF
  fi
  if [[ "$NGINX_CONF_PATH" == *sites-available* ]]; then
    mkdir -p /etc/nginx/sites-enabled
    ln -sf "$NGINX_CONF_PATH" "/etc/nginx/sites-enabled/$(basename "$NGINX_CONF_PATH")"
  fi
  VHOST_PATH="$NGINX_CONF_PATH"
  log "wrote nginx config: $NGINX_CONF_PATH"
}

write_apache_vhost() {
  local domain="$1" port="$2" mode="$3"
  resolve_apache_conf_path
  mkdir -p "$(dirname "$APACHE_CONF_PATH")"
  if [[ "$mode" == "selfsigned" ]]; then
    cat > "$APACHE_CONF_PATH" <<EOF
<VirtualHost *:80>
    ServerName $domain
    Redirect permanent / https://$domain/
</VirtualHost>

<VirtualHost *:443>
    ServerName $domain
    SSLEngine on
    SSLCertificateFile $TLS_DIR/selfsigned.crt
    SSLCertificateKeyFile $TLS_DIR/selfsigned.key

    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:$port/
    ProxyPassReverse / http://127.0.0.1:$port/
    Timeout 3600
</VirtualHost>
EOF
  else
    cat > "$APACHE_CONF_PATH" <<EOF
<VirtualHost *:80>
    ServerName $domain
    ProxyPreserveHost On
    ProxyPass / http://127.0.0.1:$port/
    ProxyPassReverse / http://127.0.0.1:$port/
    Timeout 3600
</VirtualHost>
EOF
  fi
  if command -v a2enmod >/dev/null 2>&1; then
    a2enmod proxy proxy_http ssl >/dev/null 2>&1 || true
  fi
  if command -v a2ensite >/dev/null 2>&1 && [[ "$APACHE_CONF_PATH" == *sites-available* ]]; then
    a2ensite "$(basename "$APACHE_CONF_PATH")" >/dev/null 2>&1 || true
  fi
  VHOST_PATH="$APACHE_CONF_PATH"
  log "wrote apache config: $APACHE_CONF_PATH"
}

# Syntax-checks the generated config, then (only if that passes) enables and
# (re)starts the service. Returns 1 without touching the running service if
# the check fails, so a bad generated config never takes down a
# previously-working proxy.
reload_webserver() {
  local webserver="$1"
  webserver_pkg_and_svc "$webserver"
  if [[ "$webserver" == "nginx" ]] && command -v nginx >/dev/null 2>&1; then
    if ! nginx -t 2>&1 | tee /tmp/wbdash-nginx-test.log 1>&2; then
      log "nginx config test failed -- see above"
      return 1
    fi
  elif [[ "$webserver" == "apache" ]]; then
    local testcmd=""
    command -v apachectl >/dev/null 2>&1 && testcmd=apachectl
    [[ -z "$testcmd" ]] && command -v apache2ctl >/dev/null 2>&1 && testcmd=apache2ctl
    [[ -z "$testcmd" ]] && command -v httpd >/dev/null 2>&1 && testcmd=httpd
    if [[ -n "$testcmd" ]] && ! "$testcmd" -t 2>&1 | tee /tmp/wbdash-apache-test.log 1>&2; then
      log "apache config test failed -- see above"
      return 1
    fi
  fi
  systemctl enable --now "$WS_SVC" >/dev/null 2>&1 \
    || systemctl restart "$WS_SVC" >/dev/null 2>&1 \
    || service "$WS_SVC" restart >/dev/null 2>&1 \
    || true
  return 0
}

# --- TLS ---------------------------------------------------------------

generate_selfsigned_cert() {
  local domain="$1" san
  mkdir -p "$TLS_DIR"
  chmod 750 "$TLS_DIR" 2>/dev/null || true
  if [[ "$domain" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then san="IP:$domain"; else san="DNS:$domain"; fi
  log "generating a self-signed certificate for $domain (365 days)..."
  openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout "$TLS_DIR/selfsigned.key" -out "$TLS_DIR/selfsigned.crt" \
    -subj "/CN=$domain" -addext "subjectAltName=$san" >/tmp/wbdash-openssl.log 2>&1 \
  || openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout "$TLS_DIR/selfsigned.key" -out "$TLS_DIR/selfsigned.crt" \
    -subj "/CN=$domain" >/tmp/wbdash-openssl.log 2>&1 \
  || die "openssl failed to generate a self-signed certificate -- see /tmp/wbdash-openssl.log"
  chmod 644 "$TLS_DIR/selfsigned.crt"
  chmod 640 "$TLS_DIR/selfsigned.key"
  log "self-signed cert: $TLS_DIR/selfsigned.crt"
}

# obtain_letsencrypt_cert <nginx|apache> <domain> -- runs certbot's
# webserver plugin, which edits the vhost written by write_vhost in place to
# add the ssl_certificate/SSLCertificateFile directives and (by default) an
# HTTP->HTTPS redirect. Requires the domain to already resolve here and port
# 80 to be reachable from the internet; on any failure this returns 1 and
# changes nothing else, so the caller can fall back to a self-signed cert.
obtain_letsencrypt_cert() {
  local webserver="$1" domain="$2"
  if ! command -v certbot >/dev/null 2>&1; then
    log "certbot not found, installing..."
    local pkgs=(certbot)
    case "$PKG_MGR:$webserver" in
      apt:nginx) pkgs+=(python3-certbot-nginx) ;;
      apt:apache) pkgs+=(python3-certbot-apache) ;;
      dnf:nginx|yum:nginx) pkgs+=(python3-certbot-nginx) ;;
      dnf:apache|yum:apache) pkgs+=(python3-certbot-apache) ;;
      zypper:nginx) pkgs+=(python3-certbot-nginx) ;;
      zypper:apache) pkgs+=(python3-certbot-apache) ;;
    esac
    try_pkg_install "${pkgs[@]}" || { log "could not install certbot"; return 1; }
  fi
  local plugin_flag="--apache"
  [[ "$webserver" == "nginx" ]] && plugin_flag="--nginx"
  if certbot "$plugin_flag" -d "$domain" --agree-tos --register-unsafely-without-email \
      --non-interactive 2>&1 | tee /tmp/wbdash-certbot.log 1>&2; then
    if [[ "$webserver" == "nginx" ]]; then VHOST_PATH="$NGINX_CONF_PATH (certbot-managed)"
    else VHOST_PATH="$APACHE_CONF_PATH (certbot-managed)"
    fi
    return 0
  fi
  log "certbot failed -- see /tmp/wbdash-certbot.log (common causes: DNS for $domain doesn't point here yet, or port 80/443 isn't reachable from the internet)"
  return 1
}

# --- Wizard + dispatch ---------------------------------------------------

save_prod_conf() {
  mkdir -p "$(dirname "$PROD_CONF_FILE")"
  printf 'PROD_CONFIGURED=%q\nPROD_WEBSERVER=%q\nPROD_TLS=%q\nPROD_DOMAIN=%q\nPROD_VHOST_PATH=%q\n' \
    "$PROD_CONFIGURED" "$PROD_WEBSERVER" "$PROD_TLS" "$PROD_DOMAIN" "$PROD_VHOST_PATH" > "$PROD_CONF_FILE"
}

# cmd_production always runs as root (it re-execs itself with sudo, same as
# cmd_install) so it can install packages and write /etc config -- but the
# panel process itself must NOT end up owned by root: that's both a step
# backwards on the "don't run this as root" guidance in README.md, and it'd
# make a later plain `wbdash stop`/`status` (run as the normal user) unable
# to even see the process, since kill -0 against a root-owned pid from a
# non-root shell fails. So instead of starting the panel directly here, hand
# off to a fresh non-root `wbdash start/restart --daemon` under the real
# user -- same pidfile/log paths, same ownership as every other path that
# starts the panel. $real_user is set once in cmd_production before this is
# called. PANEL_FORCE_SSL is threaded through via `env` on the *outer*
# (root) sudo call so it's present in the environment cmd_start's own `env
# PANEL_HOST=... PANEL_PORT=...` wrapper inherits down to the panel binary.
start_panel_as_real_user() {
  local mode="${1:-start}"
  local force_ssl=(); [[ "$PROD_TLS" != "none" ]] && force_ssl=(PANEL_FORCE_SSL=1)
  sudo -u "$real_user" -H env "${force_ssl[@]}" "$SELF_PATH" "$mode" \
    --host "$WBDASH_HOST_DEFAULT" --port "$WBDASH_PORT_DEFAULT" --daemon
}

# Starts whatever isn't currently running (panel and, if configured, the web
# server) without touching the wizard's saved choices. Used both after the
# wizard finishes and on every "already configured" re-run of `production`.
ensure_running_production() {
  mkdir -p "$(dirname "$PIDFILE")"
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    log "panel: running (pid $(cat "$PIDFILE"))"
  else
    log "panel was not running -- starting it..."
    start_panel_as_real_user
    sleep 1
    log "panel: started (pid $(cat "$PIDFILE" 2>/dev/null || echo '?'))"
  fi
  if [[ "$PROD_WEBSERVER" != "none" ]]; then
    webserver_pkg_and_svc "$PROD_WEBSERVER"
    if systemctl is-active --quiet "$WS_SVC" 2>/dev/null; then
      log "$WS_SVC: running"
    else
      log "$WS_SVC was not running -- starting it..."
      systemctl start "$WS_SVC" >/dev/null 2>&1 || service "$WS_SVC" start >/dev/null 2>&1 \
        || log "warning: could not start $WS_SVC -- start it manually"
    fi
  fi
}

run_production_wizard() {
  ensure_dialog

  ui_menu "Reverse proxy" "Which web server should front the KingsEmpire Manage Panel?" \
    nginx  "nginx (recommended)" \
    apache "Apache httpd" \
    skip   "Skip -- I'll handle the reverse proxy/TLS myself" || true
  local webserver="${UI_RESULT:-skip}"
  [[ "$webserver" != "nginx" && "$webserver" != "apache" ]] && webserver="none"

  if [[ "$webserver" == "none" ]]; then
    ui_msg "Skipping reverse proxy setup. The panel keeps listening directly on $WBDASH_HOST_DEFAULT:$WBDASH_PORT_DEFAULT -- put your own TLS-terminating proxy in front of it before handing out access to customers."
  else
    webserver_pkg_and_svc "$webserver"
    if command -v "$WS_SVC" >/dev/null 2>&1; then
      log "$webserver appears to already be installed."
    elif ui_yesno "$webserver isn't installed. Install it now via $PKG_MGR ($WS_PKG)?"; then
      if ! try_pkg_install "$WS_PKG"; then
        ui_msg "Failed to install $WS_PKG automatically. Install it yourself, then re-run 'wbdash production --reconfigure'."
        webserver="none"
      fi
    else
      ui_msg "Okay, not installing $webserver. Reverse proxy/TLS steps will be skipped -- set it up yourself."
      webserver="none"
    fi
  fi

  local tls="none"
  if [[ "$webserver" != "none" ]]; then
    if ui_yesno "Get a TLS certificate for the panel?"; then
      ui_menu "TLS certificate" "How should the certificate be obtained?" \
        letsencrypt "Let's Encrypt (needs a real domain pointing here)" \
        selfsigned  "Self-signed (works with an IP, browsers will warn)" || true
      tls="${UI_RESULT:-selfsigned}"
      [[ "$tls" != "letsencrypt" && "$tls" != "selfsigned" ]] && tls="selfsigned"
    fi
  fi

  ui_input "Domain name or IP the panel should be reached at:" "$(detect_lan_ip)" || true
  local domain="$UI_RESULT"
  [[ -z "$domain" ]] && die "a domain or IP is required for production setup"

  if [[ "$tls" == "letsencrypt" && "$domain" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    ui_msg "Let's Encrypt can't issue a certificate for a bare IP address ($domain) -- falling back to a self-signed certificate."
    tls="selfsigned"
  fi

  local port="$WBDASH_PORT_DEFAULT"
  VHOST_PATH=""

  if [[ "$webserver" != "none" ]]; then
    write_vhost "$webserver" "$domain" "$port" "none"
    if ! reload_webserver "$webserver"; then
      ui_msg "The generated $webserver config didn't pass its syntax check (see the terminal output above). Aborting production setup -- nothing else was changed."
      return 1
    fi

    if [[ "$tls" == "letsencrypt" ]]; then
      if obtain_letsencrypt_cert "$webserver" "$domain"; then
        log "Let's Encrypt certificate obtained and wired in by certbot."
      else
        ui_msg "Let's Encrypt failed for $domain -- falling back to a self-signed certificate so the panel is still reachable over HTTPS. (See the log above for why it failed -- usually DNS not pointed here yet, or port 80 unreachable.)"
        tls="selfsigned"
      fi
    fi

    if [[ "$tls" == "selfsigned" ]]; then
      generate_selfsigned_cert "$domain"
      write_vhost "$webserver" "$domain" "$port" "selfsigned"
      if ! reload_webserver "$webserver"; then
        ui_msg "The self-signed HTTPS config didn't pass its syntax check -- falling back to plain HTTP so the panel stays reachable. Check the terminal output above."
        tls="none"
        write_vhost "$webserver" "$domain" "$port" "none"
        reload_webserver "$webserver" || true
      fi
    fi
  fi

  PROD_CONFIGURED=1
  PROD_WEBSERVER="$webserver"
  PROD_TLS="$tls"
  PROD_DOMAIN="$domain"
  PROD_VHOST_PATH="$VHOST_PATH"
  save_prod_conf

  if [[ "$webserver" != "none" ]]; then
    save_conf "127.0.0.1" "$port"
    WBDASH_HOST_DEFAULT="127.0.0.1"
    log "panel now bound to 127.0.0.1:$port -- only reachable through $webserver"
  fi

  # Stop as root first (root can kill a stale root-owned pid from an older
  # `production` run too, which a plain non-root stop below could not), then
  # hand the actual start off to the real user -- see start_panel_as_real_user.
  cmd_stop
  start_panel_as_real_user start
  sleep 1

  echo
  log "=== production setup complete ==="
  log "web server: $webserver"
  log "TLS:        $tls"
  if [[ "$webserver" == "none" ]]; then
    log "URL:        http://$domain:$port/  (no reverse proxy -- set one up yourself before going live)"
  elif [[ "$tls" == "none" ]]; then
    log "URL:        http://$domain/"
  else
    log "URL:        https://$domain/"
  fi
  [[ -n "$PROD_VHOST_PATH" ]] && log "vhost file: $PROD_VHOST_PATH"
  log "panel process: $WBDASH_HOST_DEFAULT:$port (pid $(cat "$PIDFILE" 2>/dev/null || echo '?'))"
}

cmd_production() {
  local reconfigure=0
  for arg in "$@"; do
    case "$arg" in
      --reconfigure) reconfigure=1 ;;
    esac
  done

  if [[ $EUID -ne 0 ]]; then
    log "production setup touches system packages and /etc -- re-running with sudo..."
    exec sudo -E "$SELF_PATH" production "$@"
  fi

  # Not `local` -- start_panel_as_real_user (called from both branches below)
  # reads this too.
  real_user="${SUDO_USER:-$(logname 2>/dev/null || echo root)}"

  require_installed

  read -r -s -p "[wbdash] Production setup password: " pass
  echo
  if [[ "$pass" != "$PRODUCTION_PASSWORD" ]]; then
    die "incorrect password"
  fi

  detect_pkg_mgr

  if [[ "$PROD_CONFIGURED" == "1" && $reconfigure -eq 0 ]]; then
    log "production already configured:"
    log "  web server: $PROD_WEBSERVER"
    log "  TLS:        $PROD_TLS"
    log "  domain/IP:  $PROD_DOMAIN"
    log "  vhost:      $PROD_VHOST_PATH"
    ensure_running_production
    log "re-run 'wbdash production --reconfigure' to change any of this."
    return
  fi

  run_production_wizard
}

# --- Dispatch ---------------------------------------------------------------

cmd="${1:-}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
  install) cmd_install "$@" ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  restart) cmd_stop; sleep 1; cmd_start "$@" ;;
  manage) cmd_manage "$@" ;;
  debug|--debug) cmd_debug "$@" ;;
  production|--production) cmd_production "$@" ;;
  help|-h|--help) print_help ;;
  "")
    if [[ ! -x "$PANEL_BIN" ]]; then
      cmd_install
    fi
    cmd_start
    ;;
  --host|--port|--daemon)
    # flags given with no command, e.g. `wbdash --port 2667` -- shorthand for `start`
    if [[ ! -x "$PANEL_BIN" ]]; then
      cmd_install
    fi
    cmd_start "$cmd" "$@"
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    print_help
    exit 1
    ;;
esac
